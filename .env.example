# ==============================================================================
# AI-POWERED RESUME & JOB MATCHING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port & Environment
PORT=8080
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Atlas Cloud Database Connection String (Strict Cloud Mode - No Local Fallback)
# Set ATLASDB, ATLASDB_URL, or MONGODB_URI to your MongoDB Atlas cluster URI
# Note: Local storage database (127.0.0.1 / localhost) is strictly blocked by backend.
# ------------------------------------------------------------------------------
ATLASDB=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/ai_resume_system?retryWrites=true&w=majority
ATLASDB_URL=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/ai_resume_system?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/ai_resume_system?retryWrites=true&w=majority

# Session Encryption Secret (Use a strong random 32+ character string)
SESSION_SECRET=your_super_secret_session_key_here_at_least_32_chars

# ------------------------------------------------------------------------------
# Cloudinary Cloud Storage Configuration
# Obtain credentials from Cloudinary Console Dashboard (https://console.cloudinary.com/)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration
# Obtain API key from Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_SECONDARY_FALLBACK_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# Frontend Client URLs (For CORS, redirection, and password reset links)
# In production on Vercel: https://your-app.vercel.app
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Transactional Email Service Configuration (Nodemailer / SMTP)
# Works with Gmail App Passwords, SendGrid, Amazon SES, Mailgun, Postmark
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
EMAIL_FROM="AI Resume & Careers" <your_email@gmail.com>

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (for "Sign in with Google")
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8080/api/auth/google/callback
# Production redirect URI: https://your-backend.onrender.com/api/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
