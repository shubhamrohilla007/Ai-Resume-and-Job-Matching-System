<% layout("layouts/boilerplate") %>

<section class="hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <h1 class="display-4 fw-bold">

                    AI Powered Resume &
                    <span class="text-primary">
                        Job Matching
                    </span>

                </h1>

                <p class="lead mt-4">

                    Upload your resume and let AI analyze it.

                    Get ATS Score, Resume Feedback, Skill Gap Analysis,
                    and Personalized Job Recommendations.

                </p>

                <div class="mt-4">

                    <a href="/signup"
                       class="btn btn-primary btn-lg me-3">

                        Get Started

                    </a>

                    <a href="/jobs"
                       class="btn btn-outline-dark btn-lg">

                        Explore Jobs

                    </a>

                </div>

            </div>

            <div class="col-lg-6 text-center">

                <img
                    src="/images/hero.jpg"
                    class="img-fluid hero-image"
                    alt="AI Resume">

            </div>

        </div>

    </div>

</section>
<section class="container py-5">

    <div class="text-center mb-5">

        <h2>Why Choose Our Platform?</h2>

        <p>
            Everything you need to improve your resume and land your dream job.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-file-earmark-check display-4 text-primary"></i>

                    <h4 class="mt-3">

                        ATS Resume Score

                    </h4>

                    <p>

                        Analyze your resume for ATS compatibility.

                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-robot display-4 text-success"></i>

                    <h4 class="mt-3">

                        AI Feedback

                    </h4>

                    <p>

                        Get intelligent suggestions to improve your resume.

                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <i class="bi bi-briefcase display-4 text-warning"></i>

                    <h4 class="mt-3">

                        Job Matching

                    </h4>

                    <p>

                        Find jobs that match your skills and experience.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">How It Works</h2>

        <p class="text-muted">
            Get your dream job in four simple steps.
        </p>

    </div>

    <div class="row text-center">

        <div class="col-md-3">

            <div class="step-card">

                <div class="step-circle">
                    1
                </div>

                <i class="bi bi-upload display-4 text-primary mt-3"></i>

                <h4 class="mt-3">Upload Resume</h4>

                <p class="text-muted">
                    Upload your resume in PDF or DOCX format.
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="step-card">

                <div class="step-circle">
                    2
                </div>

                <i class="bi bi-cpu display-4 text-success mt-3"></i>

                <h4 class="mt-3">AI Analysis</h4>

                <p class="text-muted">
                    Gemini AI analyzes your resume and extracts skills.
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="step-card">

                <div class="step-circle">
                    3
                </div>

                <i class="bi bi-graph-up-arrow display-4 text-warning mt-3"></i>

                <h4 class="mt-3">ATS Score</h4>

                <p class="text-muted">
                    Receive ATS score and improvement suggestions.
                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="step-card">

                <div class="step-circle">
                    4
                </div>

                <i class="bi bi-briefcase-fill display-4 text-danger mt-3"></i>

                <h4 class="mt-3">Apply Jobs</h4>

                <p class="text-muted">
                    Explore AI-recommended jobs and apply instantly.
                </p>

            </div>

        </div>

    </div>

</section>

