
<% layout("layouts/boilerplate") %>

<div class="container py-5">

    <!-- Welcome Section -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 class="fw-bold mb-2">
                        Welcome, <%= currUser.fullName %> 👋
                    </h2>

                    <p class="text-muted mb-0">
                        Manage your profile, resume and track your
                        AI-powered career journey.
                    </p>
                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="/resume/choose" class="btn btn-primary">
                        <i class="bi bi-file-earmark-plus"></i>
                        Make Resume
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4">

        <!-- My Profile -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle display-4 text-primary"></i>

                    <h4 class="mt-3">My Profile</h4>

                    <p class="text-muted">
                        View and update your personal profile.
                    </p>

                    <a href="/profile" class="btn btn-outline-primary w-100">
                        View Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- Make Resume -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-plus display-4 text-primary"></i>

                    <h4 class="mt-3">Make Resume</h4>

                    <p class="text-muted">
                        Create a professional resume manually or with AI.
                    </p>

                    <a href="/resume/choose"
                       class="btn btn-outline-primary w-100">
                        Create Resume
                    </a>
                </div>
            </div>
        </div>

        <!-- Uploaded Resume -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-arrow-up display-4 text-success"></i>

                    <h4 class="mt-3">My Uploaded Resume</h4>

                    <p class="text-muted">
                        Upload, view or replace your existing PDF resume.
                    </p>

                    <a href="/resume/view"
                       class="btn btn-outline-success w-100">
                        View Uploaded Resume
                    </a>
                </div>
            </div>
        </div>

        <!-- NEW: My Created Resume -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-person display-4 text-info"></i>

                    <h4 class="mt-3">My Created Resume</h4>

                    <p class="text-muted">
                        View, edit and print the resume created using
                        your AI or manual Resume Builder.
                    </p>

                    <a href="/resume/builder/preview"
                       class="btn btn-outline-info w-100">
                        View Created Resume
                    </a>
                </div>
            </div>
        </div>

        <!-- ATS Score -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-bar-chart-line-fill display-4 text-warning"></i>

                    <h4 class="mt-3">ATS Score</h4>

                    <h3 class="fw-bold text-warning">--</h3>

                    <p class="text-muted">
                        Analyze your uploaded resume for ATS compatibility.
                    </p>

                    <a href="/resume/analysis"
                       class="btn btn-warning w-100">
                        View Analysis
                    </a>
                </div>
            </div>
        </div>

        <!-- AI Feedback -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-robot display-4 text-info"></i>

                    <h4 class="mt-3">AI Feedback</h4>

                    <p class="text-muted">
                        Receive intelligent suggestions to improve
                        your resume.
                    </p>

                    <a href="/resume/analysis"
                       class="btn btn-info text-white w-100">
                        View AI Feedback
                    </a>
                </div>
            </div>
        </div>

        <!-- Recommended Jobs -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-briefcase-fill display-4 text-danger"></i>

                    <h4 class="mt-3">Recommended Jobs</h4>

                    <p class="text-muted">
                        Discover AI-matched job opportunities.
                    </p>

                    <a href="/jobs/recommended" class="recommended-jobs-btn">
                        View Recommended Jobs
                    </a>
                </div>
            </div>
        </div>

        <!-- Applications -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-journal-check display-4 text-secondary"></i>

                    <h4 class="mt-3">My Applications</h4>

                    <p class="text-muted">
                        Track your applied jobs and application status.
                    </p>

                    <button class="btn btn-secondary w-100" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>