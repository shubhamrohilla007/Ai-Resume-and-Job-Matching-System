<% layout("layouts/boilerplate") %>

<div class="container py-5">

    <!-- Welcome Section -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 class="fw-bold mb-2">
                        Recruiter Dashboard 👋
                    </h2>

                    <p class="text-muted mb-0">
                        Welcome, <%= currUser.fullName %>.
                        Manage your job postings and find suitable candidates.
                    </p>
                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="/recruiter/jobs/new" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Post a Job
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recruiter Features -->
    <div class="row g-4">

        <!-- Post a Job -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-plus display-4 text-primary"></i>

                    <h4 class="mt-3">Post a Job</h4>

                    <p class="text-muted">
                        Publish a job with required skills, experience,
                        location and application details.
                    </p>

                    <a href="/recruiter/jobs/new"
                       class="btn btn-outline-primary w-100">
                        Create Job Posting
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage Jobs -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-briefcase-fill display-4 text-success"></i>

                    <h4 class="mt-3">Manage Jobs</h4>

                    <p class="text-muted">
                        View your job postings and manage their active status.
                    </p>

                    <a href="/recruiter/jobs"
                       class="btn btn-outline-success w-100">
                        View My Jobs
                    </a>
                </div>
            </div>
        </div>

        <!-- Applicants -->
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill display-4 text-info"></i>

                    <h4 class="mt-3">Applicants</h4>

                    <p class="text-muted">
                        Review candidates who apply to your job postings.
                    </p>

                    <button class="btn btn-outline-info w-100" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>