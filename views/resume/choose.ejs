<% layout("layouts/boilerplate") %>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Create Your Resume</h1>
        <p class="text-muted">
            Choose how you want to build your professional resume.
        </p>
    </div>

    <div class="row g-4 justify-content-center">

        <!-- Manual Resume -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-pencil-square display-3 text-primary"></i>

                    <h3 class="mt-3">Manual Resume</h3>

                    <p class="text-muted">
                        Enter and edit your personal details, education,
                        skills, projects and experience yourself.
                    </p>

                    <a href="/resume/builder"
                       class="btn btn-outline-primary w-100 mt-3">
                        Build Manually
                    </a>
                </div>
            </div>
        </div>

        <!-- AI Resume -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-stars display-3 text-success"></i>

                    <h3 class="mt-3">AI Resume Generator</h3>

                    <p class="text-muted">
                        Provide your actual details and target job role.
                        AI will write a professional resume for you.
                    </p>

                    <a href="/resume/builder/ai"
                       class="btn btn-success w-100 mt-3">
                        Generate with AI
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-4">
        <a href="/dashboard/jobseeker"
           class="btn btn-link text-decoration-none">
            Back to Dashboard
        </a>
    </div>
</div>
