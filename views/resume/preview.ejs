<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Resume Preview</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f3f4f6;
            font-family: Arial, sans-serif;
            color: #222;
        }

        .resume-paper {
            max-width: 850px;
            margin: 30px auto;
            padding: 45px;
            background: #fff;
            border: 1px solid #ddd;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .resume-name {
            font-size: 30px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .contact-info {
            font-size: 13px;
            color: #444;
            overflow-wrap: anywhere;
        }

        .skills-list {
            font-size: 13px;
            line-height: 1.55;
        }

        .skill-row {
            margin-bottom: 4px;
            overflow-wrap: anywhere;
        }

        .skill-row strong {
            font-weight: 700;
        }

        .resume-bullets {
            margin: 7px 0 0;
            padding-left: 20px;
            font-size: 13px;
            line-height: 1.5;
        }

        .resume-bullets li {
            margin-bottom: 4px;
            padding-left: 2px;
        }

        .resume-item {
            break-inside: avoid;
        }

        .resume-section h2 {
            letter-spacing: 0.4px;
        }
        .resume-section {
            margin-top: 25px;
        }

        .resume-section h2 {
            font-size: 17px;
            font-weight: bold;
            text-transform: uppercase;
            border-bottom: 2px solid #222;
            padding-bottom: 6px;
            margin-bottom: 14px;
        }

        .resume-item {
            margin-bottom: 16px;
            overflow-wrap: anywhere;
        }

        .resume-item h3 {
            font-size: 15px;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .muted {
            color: #555;
            font-size: 13px;
        }

        p {
            white-space: pre-line;
            line-height: 1.6;
        }

        @media print {
            body {
                background: white;
            }

            .no-print {
                display: none !important;
            }

            .resume-paper {
                width: 100%;
                max-width: none;
                margin: 0;
                padding: 15px;
                border: none;
                box-shadow: none;
            }

            .resume-section {
                break-inside: avoid;
            }

            @page {
                size: A4;
                margin: 12mm;
            }
        }
    </style>
</head>

<body>

    <!-- Action Buttons -->
    <div class="container no-print mt-4 text-center">
        <a href="/resume/builder"
           class="btn btn-outline-secondary me-2">
            Edit Resume
        </a>

        <button
            type="button"
            onclick="window.print()"
            class="btn btn-primary me-2">
            Download / Save as PDF
        </button>

        <a href="/dashboard/jobseeker"
           class="btn btn-outline-dark">
            Dashboard
        </a>
    </div>

    <!-- Resume Content -->
    <main class="resume-paper">

        <!-- Personal Information -->
        <header class="text-center">
            <div class="resume-name">
                <%= resume.personal?.fullName || "Your Name" %>
            </div>

            <div class="contact-info">
                <% if (resume.personal?.email) { %>
                    <%= resume.personal.email %>
                <% } %>

                <% if (resume.personal?.phone) { %>
                    | <%= resume.personal.phone %>
                <% } %>

                <% if (resume.personal?.location) { %>
                    | <%= resume.personal.location %>
                <% } %>
            </div>

            <div class="contact-info mt-1">
                <% if (resume.personal?.linkedin) { %>
                    LinkedIn:
                    <%= resume.personal.linkedin %>
                <% } %>

                <% if (resume.personal?.github) { %>
                    | GitHub:
                    <%= resume.personal.github %>
                <% } %>
            </div>
        </header>

        <!-- Professional Summary -->
        <% if (resume.summary) { %>
            <section class="resume-section">
                <h2>Professional Summary</h2>
                <p><%= resume.summary %></p>
            </section>
        <% } %>

        <!-- Education -->
        <% if (resume.education?.length) { %>
            <section class="resume-section">
                <h2>Education</h2>

                <% resume.education.forEach(item => { %>
                    <div class="resume-item">
                        <h3><%= item.degree || "" %></h3>

                        <div>
                            <%= item.college || "" %>
                        </div>

                        <div class="muted">
                            <% if (item.year) { %>
                                Year: <%= item.year %>
                            <% } %>

                            <% if (item.cgpa) { %>
                                | CGPA: <%= item.cgpa %>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </section>
        <% } %>

        <!-- Technical Skills -->
        <% if (resume.skills?.length) { %>
            <section class="resume-section">
                <h2>Technical Skills</h2>

                <% const hasSkillCategories = resume.skills.some(
                    skill => typeof skill === "string" && skill.includes(":")
                ); %>

                <% if (hasSkillCategories) { %>
                    <div class="skills-list">
                        <% resume.skills.forEach(skill => { %>
                            <% const separator = skill.indexOf(":"); %>

                            <% if (separator > 0) { %>
                                <div class="skill-row">
                                    <strong>
                                        <%= skill.substring(0, separator).trim() %>:
                                    </strong>

                                    <span>
                                        <%= skill.substring(separator + 1).trim() %>
                                    </span>
                                </div>
                            <% } else { %>
                                <div class="skill-row">
                                    <%= skill %>
                                </div>
                            <% } %>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p><%= resume.skills.join(", ") %></p>
                <% } %>
            </section>
        <% } %>

        <!-- Experience -->
        <% if (resume.experience?.length) { %>
            <section class="resume-section">
                <h2>Experience</h2>

                <% resume.experience.forEach(item => { %>
                    <div class="resume-item">
                        <h3><%= item.role || "" %></h3>

                        <div>
                            <%= item.company || "" %>
                        </div>

                        <% if (item.duration) { %>
                            <div class="muted">
                                <%= item.duration %>
                            </div>
                        <% } %>

                        <% if (item.description) { %>
                            <p><%= item.description %></p>
                        <% } %>
                    </div>
                <% }) %>
            </section>
        <% } %>

        <!-- Projects -->
        <% if (resume.projects?.length) { %>
            <section class="resume-section">
                <h2>Projects</h2>

                <% resume.projects.forEach(item => { %>
                    <div class="resume-item">
                        <h3><%= item.name || "" %></h3>

                        <% if (item.technologies) { %>
                            <div class="muted">
                                Technologies:
                                <%= item.technologies %>
                            </div>
                        <% } %>


                        <% if (item.description) { %>
                            <% const projectLines = item.description
                                .split(/\r?\n/)
                                .map(line => line.replace(/^•\s*/, "").trim())
                                .filter(Boolean); %>

                            <% if (projectLines.length > 1 || item.description.trim().startsWith("•")) { %>
                                <ul class="resume-bullets">
                                    <% projectLines.forEach(line => { %>
                                        <li><%= line %></li>
                                    <% }) %>
                                </ul>
                            <% } else { %>
                                <p><%= item.description %></p>
                            <% } %>
                        <% } %>
                    </div>
                <% }) %>
            </section>
        <% } %>

        <!-- Certifications -->
        <% if (resume.certifications?.length) { %>
            <section class="resume-section">
                <h2>Certifications</h2>

                <% resume.certifications.forEach(item => { %>
                    <div class="resume-item">
                        <strong><%= item.name || "" %></strong>

                        <% if (item.issuer) { %>
                            — <%= item.issuer %>
                        <% } %>

                        <% if (item.year) { %>
                            <span class="muted">
                                (<%= item.year %>)
                            </span>
                        <% } %>
                    </div>
                <% }) %>
            </section>
        <% } %>

    </main>

</body>
</html>
