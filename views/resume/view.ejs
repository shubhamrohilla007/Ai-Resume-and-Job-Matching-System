<% layout("layouts/boilerplate") %>

<div class="container py-5">

    <div class="resume-page">

        <!-- Header -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1 class="fw-bold">
                    <i class="bi bi-file-earmark-person-fill text-primary"></i>
                    My Resume
                </h1>

                <p class="text-muted mb-0">
                    View your uploaded resume
                </p>

            </div>

            <a
                href="/resume/upload"
                class="btn btn-primary">

                <i class="bi bi-upload"></i>
                Replace Resume

            </a>

        </div>


        <!-- Resume -->

        <div class="card shadow-sm resume-card">

            <div class="card-body p-4">

                <div class="row align-items-center">


                    <!-- Icon -->

                    <div class="col-md-2 text-center">

                        <% if(resume.fileType === "application/pdf"){ %>

                            <i class="bi bi-file-earmark-pdf-fill text-danger resume-icon"></i>

                        <% } else { %>

                            <i class="bi bi-file-earmark-word-fill text-primary resume-icon"></i>

                        <% } %>

                    </div>


                    <!-- Information -->

                    <div class="col-md-7">

                        <h4 class="fw-bold">

                            <%= resume.originalName %>

                        </h4>

                        <p class="text-muted mb-1">

                            <strong>Type:</strong>
                            <%= resume.fileType %>

                        </p>

                        <p class="text-muted mb-1">

                            <strong>Size:</strong>
                            <%= (resume.fileSize / 1024).toFixed(2) %> KB

                        </p>

                        <p class="text-muted mb-0">

                            <strong>Uploaded:</strong>
                            <%= new Date(resume.createdAt).toLocaleString() %>

                        </p>

                    </div>


                    <!-- Actions -->

                    <div class="col-md-3 text-md-end mt-3 mt-md-0">

                        <a
                            href="/resume/file" target="_blank" class="btn btn-primary mb-2"
                            target="_blank"
                            class="btn btn-primary mb-2">
                            <i class="bi bi-eye"></i>
                            View
                        </a>

                        <a
                            href="/resume/download"
                            download
                            class="btn btn-outline-secondary">

                            <i class="bi bi-download"></i>
                            Download

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Analysis -->

        <div class="card shadow-sm mt-4">

            <div class="card-body p-4">

                <h4 class="fw-bold">

                    <i class="bi bi-stars text-primary"></i>
                    AI Analysis

                </h4>

                <hr>

                <div class="row">

                    <div class="col-md-4 text-center">

                        <h1 class="text-primary fw-bold">

                            <%= resume.atsScore %>%

                        </h1>

                        <p class="text-muted">
                            ATS Score
                        </p>

                    </div>

                    <div class="col-md-8">

                        <p>
                            Your resume has been analyzed by our AI system.
                        </p>

                        <a
                            href="/resume/analysis"
                            class="btn btn-primary">

                            View Full Analysis

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>