
<% layout("layouts/boilerplate") %>

<div class="container py-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold">Manage Jobs</h2>
            <p class="text-muted mb-0">
                View and manage your job postings.
            </p>
        </div>

        <a href="/recruiter/jobs/new" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Post a Job
        </a>
    </div>

    <% if (!jobs || jobs.length === 0) { %>

        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-briefcase display-4 text-muted"></i>

                <h4 class="mt-3">No jobs posted yet</h4>

                <p class="text-muted">
                    Create your first job posting to get started.
                </p>

                <a href="/recruiter/jobs/new" class="btn btn-primary">
                    Post Your First Job
                </a>
            </div>
        </div>

    <% } else { %>

        <div class="row g-4">

            <% jobs.forEach(job => { %>

                <div class="col-lg-6" key="<%= job._id %>">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <h4 class="fw-bold">
                                        <%= job.title %>
                                    </h4>

                                    <p class="text-muted">
                                        <%= job.company %>
                                    </p>
                                </div>

                                <% if (job.isActive) { %>
                                    <span class="badge text-bg-success align-self-start">
                                        Active
                                    </span>
                                <% } else { %>
                                    <span class="badge text-bg-secondary align-self-start">
                                        Closed
                                    </span>
                                <% } %>
                            </div>

                            <p class="small text-muted">
                                <i class="bi bi-geo-alt"></i>
                                <%= job.location %>
                                · <%= job.jobType %>
                                · <%= job.experienceLevel %>
                            </p>

                            <p>
                                <%= job.description.length > 180
                                    ? job.description.slice(0, 180) + "..."
                                    : job.description %>
                            </p>

                            <h6 class="fw-bold">Required Skills</h6>

                            <% if (job.requiredSkills && job.requiredSkills.length) { %>
                                <% job.requiredSkills.forEach(skill => { %>
                                    <span class="badge text-bg-light border me-1 mb-1">
                                        <%= skill %>
                                    </span>
                                <% }) %>
                            <% } else { %>
                                <p class="text-muted small">No required skills added.</p>
                            <% } %>

                            <form
                                action="/recruiter/jobs/<%= job._id %>/toggle"
                                method="POST"
                                class="mt-4"
                            >
                                <% if (job.isActive) { %>
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        Close Job
                                    </button>
                                <% } else { %>
                                    <button type="submit" class="btn btn-outline-success w-100">
                                        Reactivate Job
                                    </button>
                                <% } %>
                            </form>

                        </div>
                    </div>
                </div>

            <% }) %>

        </div>

    <% } %>

</div>
